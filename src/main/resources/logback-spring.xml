<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender with colored output for local development -->
    <springProfile name="local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr([%X{correlationId:-N/A}]){blue} %clr([%X{requestId:-N/A}]){cyan} %clr(%-40.40logger{39}){green} %clr(:){faint} %m%n%wEx</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!-- JSON appender for production environments -->
    <springProfile name="!local">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp>
                        <timeZone>UTC</timeZone>
                    </timestamp>
                    <version/>
                    <logLevel/>
                    <message/>
                    <mdc/>
                    <loggerName/>
                    <pattern>
                        <pattern>
                            {
                                "service": "sidebar-backend",
                                "pid": "${PID:-}",
                                "thread": "%thread"
                            }
                        </pattern>
                    </pattern>
                    <stackTrace/>
                </providers>
            </encoder>
        </appender>
    </springProfile>

    <!-- File appender for application logs -->
    <springProfile name="!local">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/application.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>logs/application.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>10GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp>
                        <timeZone>UTC</timeZone>
                    </timestamp>
                    <version/>
                    <logLevel/>
                    <message/>
                    <mdc/>
                    <loggerName/>
                    <pattern>
                        <pattern>
                            {
                                "service": "sidebar-backend",
                                "pid": "${PID:-}",
                                "thread": "%thread"
                            }
                        </pattern>
                    </pattern>
                    <stackTrace/>
                </providers>
            </encoder>
        </appender>
    </springProfile>

    <!-- Sensitive data masking pattern for common patterns -->
    <conversionRule conversionWord="mask" 
                    converterClass="com.sidebeam.common.logging.SensitiveDataMaskingConverter" />

    <!-- Root logger configuration -->
    <springProfile name="local">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!local">
        <root level="INFO">
            <appender-ref ref="JSON"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- Application specific logging levels -->
    <logger name="com.sidebeam" level="DEBUG" additivity="false">
        <springProfile name="local">
            <appender-ref ref="CONSOLE"/>
        </springProfile>
        <springProfile name="!local">
            <appender-ref ref="JSON"/>
            <appender-ref ref="FILE"/>
        </springProfile>
    </logger>

    <!-- External libraries logging levels -->
    <logger name="org.springframework.web.client" level="DEBUG"/>
    <logger name="org.springframework.security" level="DEBUG"/>
    <logger name="io.github.resilience4j" level="INFO"/>
    <logger name="org.gitlab4j" level="INFO"/>
    
    <!-- Reduce noise from Spring Boot -->
    <logger name="org.springframework.boot.actuate" level="WARN"/>
    <logger name="org.springframework.boot.web.embedded" level="WARN"/>
    
    <!-- Health check endpoint - reduce noise -->
    <logger name="org.springframework.boot.actuate.health" level="WARN"/>
</configuration>